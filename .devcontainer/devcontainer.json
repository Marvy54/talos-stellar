{
  "name": "Stellar SDK + Prime Agent + Soroban Dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils": {}
  },
  "forwardPorts": [
    3000,
    5432,
    8000,
    8080,
    8081,
    8082,
    8888
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbwjdbj.db-client",
        "esbenz.pnpm",
        "mshenton.python",
        "rust-lang.rust-analyzer",
        "taikung.vscode-soroban"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "remoteUser": "node"
}
