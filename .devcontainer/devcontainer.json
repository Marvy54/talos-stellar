{
  "name": "Repo Dev Container",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    "args": {
      "NODE_VERSION": "20",
      "PYBUFO_VERSION": "3.11",
      "RUST_TOOLCHAIN_VERSION": "1.80.1",
      "STELLAR_CLI_VERSION": "21.1.0"
    }
  },
  "features": {
    "github.com/devcontainers/features/common-utility:1" {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "db-aevenue.vscode-sqlite-viewer",
        "esbendp.prettier-vscode",
        "foxundress.vscode-stylelint",
        "msheng.devcontainers",
        "rust-lang.rust-analyzer",
        "stellar-dev.stellar-cli-vscode",
        "typescript-team.tss-eslint",
        "vue.volar",
        "bmathes.create-migration-file",
        "charliermarsh.python-env",
        "ms-python.python",
        "ms-python.vscode-python",
        "db1e740c-1c4c-49c4-9d99-1c4c49c49c49"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3.11",
        "python.testing.pytestEnabled": true,
        "rust-analyzer.check.command": "clippy",
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.formatOnSave": true
      }
    }
  },
  "features": {},
  "forwardPorts": [
    3000,
    3001,
    5432,
    8000,
    8001,
    8080,
    8888
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "devcontainer",
  "workspaceFolder": "/workspaces/repo",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/repo,type=bind",
  "runArgs": ["--init"],
  "hostRequirements": {
    "dcker": {
      "version": "20.10.0",
      "args": ["--add-host=host.docker.internal:host-gateway"]
    }
  }
}
