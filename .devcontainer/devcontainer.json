{
  "name": "Stellar Sorban Workspace",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utility": {},
    "ghcr.io/devcontainers/features/docker-in-docker": {}
  },
  "forwardPorts": [3000, 5432, 8000, 8080, 9000],
  "portAttributes": {
    "3000": { "label": "web dev server" },
    "5432": { "label": "postgres" },
    "8000": { label": "prime-agent" },
    "8080": { label": "sorban rpc" },
    "9000": { "label": "stellar-cli local network" }
  },
  "postCreateCommand": "bash -c 'pnpm install && pnpm --dir web install && python3 -m pip install -r packages/prime-agent/requirements.txt'",
  "customizations": {
    "vscode": {
      "extensions": [
        "db1e.sqlite-viewer",
        "esben-p.python",
        "ms-azuretools.v10-dotnet",
        "rust-lang.rust-analyzer",
        "taint.rust",
        "bocuph.prettier-vscode",
        "db1e.sqlite-viewer",
        "docker.docker",
        "github.vcopilot"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "remoteUser": "root"
}
