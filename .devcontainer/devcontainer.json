{
  "name": "Stellar SDK + Prime Agent + Soroban Dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils": {}
  },
  "forwardPorts": [
    3000,
    3001,
    5432,
    8000,
    8080,
    8888,
    9000,
    9090
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "node",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbhoevem.python",
        "mscraftsls.js-debug",
        "esbendp.prettier",
        "dbwaeh.dlb",
        "rust-lang.rust-analyzer",
        "tamawoh.rust",
        "binderv.devcontainers"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
